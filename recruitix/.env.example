# --- Frontend (Vite) ---
# Base URL of the Express API. Leave empty for production on Vercel (same-origin /api
# routes); point at your local server for dev, e.g. http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787
# Firebase web app config — Firebase Console -> Project settings -> your web app. Not
# secret (it's already visible in the deployed JS bundle), but must be set identically
# here and in Vercel's project env vars, since Vite bakes these in at build time.
VITE_FIREBASE_API_KEY=replace_with_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_sender_id
VITE_FIREBASE_APP_ID=replace_with_your_app_id
VITE_FIREBASE_MEASUREMENT_ID=replace_with_your_measurement_id

# --- Backend (server/, loaded via dotenv from the repo root when running `npm run server`) ---
# Full Atlas SRV connection string from the cluster's "Connect" page in the Atlas dashboard.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/recruitix?retryWrites=true&w=majority
# Any random 32+ byte string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace_with_a_random_secret
# Free key from console.groq.com — powers the AI-driven Live Interview round.
GROQ_API_KEY=replace_with_your_groq_key
# Local dev only — Vercel provides its own port binding in production.
PORT=8787
# Used to verify Google sign-in ID tokens (server/lib/firebaseAdmin.js) — must match VITE_FIREBASE_PROJECT_ID
# above (same Firebase project, client and server sides). Defaults to the project already
# hardcoded in src/lib/firebase.ts if unset, but set it explicitly here and in Vercel.
FIREBASE_PROJECT_ID=your-project-id
